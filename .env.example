# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# RAZORPAY PAYMENT GATEWAY CONFIGURATION
# Secure server-side secrets. NEVER expose RAZORPAY_KEY_SECRET or WEBHOOK_SECRET to client.
# ==============================================================================

# RAZORPAY_MODE: Operational mode for payment gateway ('TEST' or 'LIVE'). Defaults to 'TEST'.
# Switching to 'LIVE' on the backend does NOT require any Android Play Store APK/AAB update.
RAZORPAY_MODE=TEST

# Test Environment Credentials (Used when RAZORPAY_MODE=TEST)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Live Environment Credentials (Used when RAZORPAY_MODE=LIVE)
# Injected via Cloud Run Secret Manager / server environment variables when ready for production.
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=

# ==============================================================================
# AUTHENTICATION CONFIGURATION
# Real Authentication Services: Firebase Google Auth, Mobile SMS OTP (APITxT), and Email OTP
# ==============================================================================

# FIREBASE AUTHENTICATION (Primary Google Sign-In Provider)
# Project ID: ghar-ghar-6a8f4 (configured in Firebase Console with Google Provider enabled)
# Authorized Domains must include: localhost, ghargharvastu.com, www.ghargharvastu.com
FIREBASE_PROJECT_ID=ghar-ghar-6a8f4
VITE_FIREBASE_API_KEY=AIzaSyCcg5LLZiwfCIEHfmNHJ-PVGbU3kxqAkjg
VITE_FIREBASE_AUTH_DOMAIN=ghar-ghar-6a8f4.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ghar-ghar-6a8f4
VITE_FIREBASE_STORAGE_BUCKET=ghar-ghar-6a8f4.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=73788003900
VITE_FIREBASE_APP_ID=1:73788003900:web:205cc8f226a391141d5539
VITE_FIREBASE_MEASUREMENT_ID=G-30V0Q22XRC

# OPTIONAL: Google Cloud OAuth 2.0 Web Client ID
# NOTE: NOT REQUIRED for Firebase Google Auth. Only needed if using direct Google OAuth2 token verification.
GOOGLE_CLIENT_ID=

# MOBILE OTP VIA APITXT (apitxt.com - REAL SMS GATEWAY)
# APITxT API Key from Developer Hub (https://apitxt.com). Never expose to client.
APITXT_API_KEY=
APITXT_AUTHKEY=
# Delivery channel: sms (default), whatsapp, or voice
APITXT_CHANNEL=sms
# Optional DLT Sender ID / Header if configured in APITxT
APITXT_SENDER_ID=
# OTP Expiry duration in seconds (defaults to 300 = 5 minutes)
OTP_EXPIRY_SECONDS=300

# EMAIL OTP VIA TRANSACTIONAL EMAIL PROVIDER
# Configure at least one provider (Resend, SendGrid, Postmark, or SMTP)
# Resend (Recommended, fast & modern: https://resend.com)
RESEND_API_KEY=
# Sender email address
EMAIL_FROM="VastuVision AI <verify@yourdomain.com>"

# SendGrid (Alternative)
SENDGRID_API_KEY=

# Postmark (Alternative)
POSTMARK_SERVER_TOKEN=

# SMTP Credentials (Alternative, e.g., Gmail SMTP or Custom Domain Mailserver)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

