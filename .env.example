# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# RAZORPAY PAYMENT GATEWAY CONFIGURATION
# Secure server-side secrets. NEVER expose RAZORPAY_KEY_SECRET or WEBHOOK_SECRET to client.
# ==============================================================================

# RAZORPAY_MODE: Operational mode for payment gateway ('TEST' or 'LIVE'). Defaults to 'TEST'.
# Switching to 'LIVE' on the backend does NOT require any Android Play Store APK/AAB update.
RAZORPAY_MODE=TEST

# Test Environment Credentials (Used when RAZORPAY_MODE=TEST)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Live Environment Credentials (Used when RAZORPAY_MODE=LIVE)
# Injected via Cloud Run Secret Manager / server environment variables when ready for production.
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=

# ==============================================================================
# AUTHENTICATION CONFIGURATION
# Real Authentication Services: Google OAuth, Mobile SMS OTP (MSG91), and Email OTP
# ==============================================================================

# GOOGLE OAUTH 2.0
# Web Client ID from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=

# MOBILE OTP VIA MSG91 (SMS GATEWAY)
# MSG91 Auth Key is used server-side only. Never expose to client.
MSG91_AUTH_KEY=
# DLT Approved MSG91 OTP Template ID (from MSG91 Dashboard > OTP > Templates)
MSG91_TEMPLATE_ID=
# Optional MSG91 OTP Widget ID (if using MSG91 OTP Widget flow)
MSG91_WIDGET_ID=
# Optional 6-character registered DLT Sender ID / Header (e.g., VSTVIS)
MSG91_SENDER_ID=

# EMAIL OTP VIA TRANSACTIONAL EMAIL PROVIDER
# Configure at least one provider (Resend, SendGrid, Postmark, or SMTP)
# Resend (Recommended, fast & modern: https://resend.com)
RESEND_API_KEY=
# Sender email address
EMAIL_FROM="VastuVision AI <verify@yourdomain.com>"

# SendGrid (Alternative)
SENDGRID_API_KEY=

# Postmark (Alternative)
POSTMARK_SERVER_TOKEN=

# SMTP Credentials (Alternative, e.g., Gmail SMTP or Custom Domain Mailserver)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

